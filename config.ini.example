[Pomodoro]
tempo_trabalho = 25
pausa_curta = 5
pausa_longa = 15
ciclos_para_pausa_longa = 4
bloquear_pausa = True

[Janela]
mostrar_janela = True

[Icone]
arquivo = pomodoro.ico

[Calendar]
integrado = False
