[Telegram]
ativo = False
token = SEU_TOKEN_DO_BOT_TELEGRAM
chat_id = SEU_CHAT_ID

[AppsInicioDia]
; Caminhos de aplicativos para abrir ao iniciar trabalho
; vscode = C:\Path\To\VSCode.exe
; chrome = C:\Path\To\Chrome.exe
; automacao = C:\Scripts\automacao.bat
